<UserControl x:Class="LiteQASuite.Shell.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Background}">
    <StackPanel Margin="32">
        <TextBlock Text="Configurações do LiteQASuite" FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Foreground}"/>

        <TextBlock Text="Workspace" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,6"
                   Foreground="{DynamicResource Brush.Foreground}"/>

        <Border Padding="12" HorizontalAlignment="Left" MinWidth="480"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Alterar..." Padding="12,6"
                        Command="{Binding ChangeWorkspaceCommand}"/>
                <TextBlock Text="{Binding WorkspaceRoot}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                           Foreground="{DynamicResource Brush.Foreground}"/>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>