<Window x:Class="LiteShot.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!-- Uma janela destas por monitor. A posição e o tamanho não vêm daqui: são
         aplicados por SetWindowPos em pixels físicos, no code-behind, porque as
         propriedades Left/Top/Width/Height do WPF estão em unidades independentes
         de dispositivo e ficam imprevisíveis num setup com escalas diferentes. -->

    <Window.Resources>

        <!-- Ícones desenhados como geometria vetorial. A casca ainda não tem um
             dicionário de ícones compartilhado; quando tiver, estes são os
             primeiros candidatos a subir para lá. -->
        <Geometry x:Key="Icon.Pen">M3,17 C6,6 9,18 13,7 L16,4</Geometry>
        <Geometry x:Key="Icon.Line">M4,16 L16,4</Geometry>
        <Geometry x:Key="Icon.Arrow">M4,16 L16,4 M16,4 L10,5 M16,4 L15,10</Geometry>
        <Geometry x:Key="Icon.Shape">M4,5 L16,5 L16,15 L4,15 Z</Geometry>
        <Geometry x:Key="Icon.Highlighter">M3,15 L17,6</Geometry>
        <Geometry x:Key="Icon.Undo">M8,5 L4,9 L8,13 M4,9 L13,9 A4,4 0 0 1 13,17 L9,17</Geometry>
        <Geometry x:Key="Icon.Redo">M12,5 L16,9 L12,13 M16,9 L7,9 A4,4 0 0 0 7,17 L11,17</Geometry>
        <Geometry x:Key="Icon.Copy">M6,6 L6,3 L16,3 L16,13 L13,13 M4,6 L13,6 L13,16 L4,16 Z</Geometry>
        <Geometry x:Key="Icon.Save">M10,3 L10,13 M6,9 L10,13 L14,9 M4,16 L16,16</Geometry>
        <Geometry x:Key="Icon.Close">M5,5 L15,15 M15,5 L5,15</Geometry>

        <Style x:Key="ToolIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="None"/>
        </Style>

        <!-- Botão de ferramenta: alterna, e o estado apertado é o realce de accent. -->
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.SurfaceAlt}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de ação: não alterna, só executa. -->
        <Style x:Key="ToolAction" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.SurfaceAlt}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de perfil: texto em vez de ícone, e RadioButton em vez de
             ToggleButton. Um dos dois está sempre aceso, e clicar no que já está
             ativo não deve apagá-lo — que é a definição de rádio.

             Com ToggleButton havia um descompasso visual: o clique alterna o
             IsChecked localmente, esse valor local vence o binding OneWay, e como
             o perfil não mudou nenhuma notificação voltava para corrigir. -->
        <Style x:Key="ProfileToggle" TargetType="RadioButton" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Canvas x:Name="Root" ClipToBounds="True">

        <!-- A foto congelada deste monitor, em tamanho real. -->
        <Image x:Name="ScreenshotLayer" Stretch="Fill"/>

        <!-- O escurecimento, com um buraco na área selecionada. O buraco vem da
             regra de preenchimento EvenOdd: dois retângulos sobrepostos se anulam.
             A camada de anotações é inserida logo depois desta, em código. -->
        <Path x:Name="MaskLayer" Fill="#A6000000" IsHitTestVisible="False"/>

        <!-- A moldura da seleção. -->
        <Rectangle x:Name="SelectionBorder"
                   Stroke="#FF2563EB" StrokeThickness="1.5"
                   IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- As oito alças são criadas em código: declarar oito retângulos nomeados
             no XAML só espalharia a mesma informação por dezesseis linhas. -->
        <Canvas x:Name="HandleLayer" IsHitTestVisible="False"/>

        <!-- A caixa de digitação da ferramenta de texto, posicionada onde o usuário
             clicar. Enquanto ela está aberta, o Esc pertence a ela. -->
        <TextBox x:Name="TextInput"
                 Visibility="Collapsed"
                 MinWidth="120"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource Brush.Accent}"
                 Background="#D91E2127"
                 FontFamily="Segoe UI"
                 FontWeight="SemiBold"
                 AcceptsReturn="False"/>

        <!-- A barra de ferramentas flutuante. Aparece só na janela do monitor onde
             a seleção termina, para não duplicar em setups com vários monitores. -->
        <Border x:Name="Toolbar"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="4"
                Cursor="Arrow"
                Visibility="Collapsed">

            <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal">

                <!-- Pega para arrastar a barra. Separada dos botões de propósito:
                     arrastar pelo fundo faria qualquer clique perdido mover a barra. -->
                <Border x:Name="Grip" Width="14" Height="34" Background="Transparent" Cursor="SizeAll">
                    <Path Stroke="{DynamicResource Brush.ForegroundMuted}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M5,10 L5,10 M9,10 L9,10 M5,14 L5,14 M9,14 L9,14 M5,18 L5,18 M9,18 L9,18"/>
                </Border>

                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="{Binding LabelPen}"
                              IsChecked="{Binding IsPenActive, Mode=OneWay}"
                              Command="{Binding SelectToolCommand}" CommandParameter="Pen">
                    <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Pen}"/>
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="{Binding LabelLine}"
                              IsChecked="{Binding IsLineActive, Mode=OneWay}"
                              Command="{Binding SelectToolCommand}" CommandParameter="Line">
                    <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Line}"/>
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="{Binding LabelArrow}"
                              IsChecked="{Binding IsArrowActive, Mode=OneWay}"
                              Command="{Binding SelectToolCommand}" CommandParameter="Arrow">
                    <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Arrow}"/>
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="{Binding LabelShape}"
                              IsChecked="{Binding IsShapeActive, Mode=OneWay}"
                              Command="{Binding SelectToolCommand}" CommandParameter="Shape">
                    <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Shape}"/>
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="{Binding LabelHighlighter}"
                              IsChecked="{Binding IsHighlighterActive, Mode=OneWay}"
                              Command="{Binding SelectToolCommand}" CommandParameter="Highlighter">
                    <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Highlighter}"
                          StrokeThickness="4" Opacity="0.75"/>
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolToggle}" ToolTip="{Binding LabelText}"
                              IsChecked="{Binding IsTextActive, Mode=OneWay}"
                              Command="{Binding SelectToolCommand}" CommandParameter="Text">
                    <TextBlock Text="T" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Foreground}"/>
                </ToggleButton>

                <!-- Cor da ferramenta ativa. Abre a paleta própria: o seletor de cor
                     do Windows vem do WinForms, que está fora por decisão da suíte. -->
                <Button x:Name="ColorButton" Style="{StaticResource ToolAction}"
                        ToolTip="{Binding LabelColor}" Click="ColorButton_Click">
                    <Border x:Name="ColorSwatch" Width="20" Height="20" CornerRadius="2"
                            BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"/>
                </Button>

                <Rectangle x:Name="Separator1" Width="1" Height="22" Margin="4,0"
                           Fill="{DynamicResource Brush.Border}"/>

                <Button Style="{StaticResource ToolAction}" ToolTip="{Binding LabelUndo}"
                        Command="{Binding UndoCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Undo}"/>
                </Button>

                <Button Style="{StaticResource ToolAction}" ToolTip="{Binding LabelRedo}"
                        Command="{Binding RedoCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Redo}"/>
                </Button>

                <RadioButton Style="{StaticResource ProfileToggle}" Content="P1"
                             GroupName="CaptureProfile"
                             ToolTip="{Binding LabelProfile1}"
                             IsChecked="{Binding IsProfile1Active, Mode=OneWay}"
                             Command="{Binding SelectProfileCommand}" CommandParameter="1"/>

                <RadioButton Style="{StaticResource ProfileToggle}" Content="P2"
                             GroupName="CaptureProfile"
                             ToolTip="{Binding LabelProfile2}"
                             IsChecked="{Binding IsProfile2Active, Mode=OneWay}"
                             Command="{Binding SelectProfileCommand}" CommandParameter="2"/>

                <Rectangle x:Name="Separator2" Width="1" Height="22" Margin="4,0"
                           Fill="{DynamicResource Brush.Border}"/>

                <Button Style="{StaticResource ToolAction}" ToolTip="{Binding LabelSave}"
                        Command="{Binding SaveCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Save}"/>
                </Button>

                <Button Style="{StaticResource ToolAction}" ToolTip="{Binding LabelCopy}"
                        Command="{Binding CopyCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Copy}"/>
                </Button>

                <Button Style="{StaticResource ToolAction}" ToolTip="{Binding LabelClose}"
                        Command="{Binding CancelCommand}">
                    <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Close}"/>
                </Button>

            </StackPanel>
        </Border>

        <!-- Paleta de cores. Doze cores fixas cobrem o que uma anotação de QA
             precisa; o antigo abria o seletor completo do Windows e guardava
             dezesseis cores personalizadas. -->
        <Popup x:Name="ColorPalette" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="4" Padding="6">
                <UniformGrid x:Name="PaletteGrid" Columns="6" Rows="2"/>
            </Border>
        </Popup>

        <!-- Dica dos atalhos, enquanto nada foi selecionado. -->
        <TextBlock x:Name="Hint"
                   Text="{Binding LabelHint}"
                   Foreground="#FFE6E8EB"
                   FontSize="13"
                   IsHitTestVisible="False"/>

    </Canvas>
</Window>