<Window x:Class="LiteFlow.Views.StartScenarioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource Brush.ForegroundMuted}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">

        <TextBlock Text="{Binding LabelSquad}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
        <ComboBox IsEditable="True"
                  ItemsSource="{Binding Squads}"
                  Text="{Binding Squad, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{Binding LabelSquadHint}"
                   FontSize="11"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.ForegroundMuted}"/>

        <TextBlock Text="{Binding LabelCycle}" Style="{StaticResource FieldLabel}"/>
        <ComboBox IsEditable="True"
                  ItemsSource="{Binding Cycles}"
                  Text="{Binding Cycle, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{Binding LabelCycleHint}"
                   FontSize="11"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.ForegroundMuted}"/>

        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding LabelPrefix}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding LabelScenarioId}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ScenarioId, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding LabelTestCase}" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding TestCase, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="46"
                 VerticalScrollBarVisibility="Auto"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding LabelExecutor}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Executor, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding LabelDate}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding LabelComments}" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="60"
                 VerticalScrollBarVisibility="Auto"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding LabelLayout}" Style="{StaticResource FieldLabel}"/>
                <ComboBox SelectedIndex="{Binding LayoutIndex}">
                    <ComboBoxItem Content="{Binding LabelLayoutPadrao}"/>
                    <ComboBoxItem Content="{Binding LabelLayoutMobile}"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding LabelMobileColumns}" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding MobileColumnOptions}"
                          SelectedItem="{Binding MobileColumns}"
                          IsEnabled="{Binding IsMobileLayout}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Foreground}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{Binding LabelCancel}"
                    Command="{Binding CancelCommand}"
                    MinWidth="96"
                    Padding="12,6"
                    Margin="0,0,8,0"/>
            <Button Content="{Binding LabelConfirm}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"
                    MinWidth="96"
                    Padding="12,6"/>
        </StackPanel>

    </StackPanel>
</Window>